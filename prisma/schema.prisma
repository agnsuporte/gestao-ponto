// -----------------------------------------------------------------------------
// ENUMS PARA O PERFIL FISCAL (IRS PORTUGAL)
// -----------------------------------------------------------------------------

enum TaxRegion {
  CONTINENTE
  MADEIRA
  ACORES
}

enum MaritalStatus {
  NAO_CASADO                  // Solteiro, Viúvo, Divorciado
  CASADO_UNICO_TITULAR
  CASADO_DOIS_TITULARES
}

enum MealAllowanceType {
  DINHEIRO                    // Limite de isenção de IRS/SS mais baixo
  CARTAO                      // Limite de isenção de IRS/SS mais alto
}

enum LineType {
  ABONO
  DESCONTO
}

// generator client {
//   provider = "prisma-client-js"
//   //  output   = "generated/prisma"
// }
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  billingStatus        String?
  accounts             Account[]
  sessions             Session[]
  timeRecords          TimeRecord[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TimeRecord {
  id               String   @id @default(cuid())
  date             String
  turno1_entrada   String?
  turno1_saida     String?
  almoco_entrada   String?
  almoco_saida     String?
  turno2_entrada   String?
  turno2_saida     String?
  total_minutes    Int?
  overtime_minutes Int?
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([userId])
  @@unique([userId, date])
}

// -----------------------------------------------------------------------------
// DEFINIÇÕES SALARIAIS E FISCAIS DO UTILIZADOR
// -----------------------------------------------------------------------------

model UserSalarySettings {
  id                 String            @id @default(cuid())
  userId             String            @unique
  baseSalary         Decimal           @db.Decimal(10, 2) @default(900.00)
  hasHolidayBonus    Boolean           @default(true)
  hasChristmasBonus  Boolean           @default(true)
  gratification      Decimal           @db.Decimal(10, 2) @default(0.00)
  
  // Perfil Fiscal para Escalões de IRS Dinâmicos
  taxRegion          TaxRegion         @default(CONTINENTE)
  maritalStatus      MaritalStatus     @default(NAO_CASADO)
  dependentsCount    Int               @default(0)

  // Configurações do Subsídio de Alimentação
  mealAllowanceValue Decimal           @db.Decimal(10, 2) @default(0.00)
  mealAllowanceType  MealAllowanceType @default(CARTAO)

  updatedAt          DateTime          @updatedAt
}

model Payslip {
  id              String        @id @default(cuid())
  userId          String        // Relacionado com o seu sistema de Users
  month           Int           // 1 a 12
  year            Int
  baseSalary      Decimal       @db.Decimal(10, 2) // Ex: 900.00
  totalGross      Decimal       @db.Decimal(10, 2) // Ex: 1530.00
  totalDeductions Decimal       @db.Decimal(10, 2) // Ex: 242.32
  netSalary       Decimal       @db.Decimal(10, 2) // Total Líquido (1368.49)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           PayslipLine[]

  @@unique([userId, month, year]) // Impede recibos duplicados para o mesmo mês
  @@index([userId])
}

model PayslipLine {
  id          String   @id @default(cuid())
  payslipId   String
  payslip     Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  code        String   // Ex: "001", "301"
  description String   // Ex: "Vencimento", "Segurança Social"
  type        LineType // ABONO ou DESCONTO
  quantity    Decimal? @db.Decimal(10, 2) // Dias ou Horas (Ex: 30.00 ou 18.00)
  unitValue   Decimal? @db.Decimal(10, 2) // Valor Unitário (Ex: 31.83)
  rate        Decimal? @db.Decimal(5, 2)  // Percentagem / Taxa (Ex: 11.00 ou 7.78)
  baseValue   Decimal? @db.Decimal(10, 2) // Base de incidência (Ex: 1302.92)
  totalValue  Decimal  @db.Decimal(10, 2) // Valor Final (Ex: 955.00, 143.32)
}
